# ---------------------------------------------------------------------------
# LEGO Set -> 3D Printable STL Generator : configuration
# Copy to .env and adjust. Every value below has a working default,
# so the application runs with an empty .env file.
# ---------------------------------------------------------------------------

# --- Storage --------------------------------------------------------------
# SQLite database holding the part index, job records and cache metadata.
DATABASE_URL=sqlite:///data/app.sqlite3
# Where downloaded source datasets (Rebrickable CSV + LDraw library) live.
SOURCE_DIRECTORY=data/sources
# Persistent STL geometry cache, shared by every job and every user.
CACHE_DIRECTORY=data/cache
# Per-job working directories and generated ZIP files.
OUTPUT_DIRECTORY=data/jobs

# --- Generation tuning ----------------------------------------------------
# Parallel geometry conversions. 5-10 is a sensible range.
MAX_CONCURRENT_DOWNLOADS=8
# Hard limit on a single generation job, in seconds.
JOB_TIMEOUT=1800
# Delete finished jobs (and their ZIPs) after this many seconds. Default 24h.
JOB_RETENTION=86400
# Discard cached geometry older than this many seconds. Default 30 days.
CACHE_RETENTION=2592000
# Retry attempts per part before it is reported as failed.
MAX_RETRIES=3
# Refuse to build sets larger than this many physical pieces (abuse guard).
MAX_PIECES_PER_JOB=6000
# Refuse to serve a ZIP larger than this many bytes (default 2 GiB).
MAX_ZIP_BYTES=2147483648

# --- Rate limiting --------------------------------------------------------
# Generation requests allowed per client IP per window.
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# --- STL / geometry -------------------------------------------------------
# LDraw unit -> millimetre scale. 1 LDU = 0.4 mm. Do not change unless you
# know exactly what you are doing.
LDU_MM=0.4
# Uniform scale applied to every exported part. LDraw geometry is *nominal*
# (a 2x4 brick is 32.00 mm) whereas real LEGO bricks are moulded slightly
# undersize (31.80 mm) to leave clutch tolerance. 1.0 keeps LDraw geometry
# untouched; 0.994 reproduces real-brick dimensions. See README.
PART_SCALE=1.0
# Write binary STL (much smaller). Set to false for ASCII STL.
STL_BINARY=true
# Place parts on the build plate before export (rests them on Z=0).
AUTO_ORIENT=true
# How to orient them. "native" keeps LDraw's orientation, which already has
# the flat underside down and the studs up — the right answer for almost
# every LEGO element. "flat" instead lays each part on its largest face.
ORIENT_STRATEGY=native

# --- Build plates ---------------------------------------------------------
# Which printer's bed to arrange parts on. One of:
#   bambu_a1_mini (180x180)  bambu_a1 / bambu_p1 / bambu_x1 (256x256)
#   bambu_h2d (325x320)      prusa_mk4 (250x210)
#   ender_3 (220x220)        voron_350 (350x350)
BED_PRESET=bambu_p1
# Gap between parts on a plate, and clear margin at the bed edge, in mm.
PLATE_GAP_MM=3.0
PLATE_MARGIN_MM=5.0
# How to group parts onto plates:
#   none   - ignore colour, pack purely by size (fewest plates)
#   family - group similar colours, so one filament prints a whole plate
#   exact  - one group per exact LEGO colour
COLOR_MODE=family
# Most filament colours a set may need. Similar colours are merged until only
# this many remain, so you are not asked to own twelve spools. 0 = no limit.
MAX_COLORS=4
# Write pre-arranged 3MF plate files (open one, it is ready to slice).
BUILD_PLATES=true
# How to deliver them:
#   separate - one file per plate; plain 3MF, opens in any slicer
#   project  - ONE file containing every plate, each named after its colour
#   both     - ship both (default), so either workflow is available
PLATE_OUTPUT=separate
# Also write one STL per piece. Off by default: a big set is 800+ files.
INCLUDE_STLS=false
# Safety limit on plates per job.
MAX_PLATES=60

# --- Print estimates ------------------------------------------------------
# Used for the filament / cost / time figures on the results page. Set these
# to match your own slicer profile and filament price and the numbers will
# track your real prints. The slicer is always the authority.
LAYER_HEIGHT_MM=0.2
WALL_COUNT=2
LINE_WIDTH_MM=0.42
INFILL_PERCENT=15
# PLA 1.24, PETG 1.27, ABS 1.04 g/cm3
FILAMENT_DENSITY=1.24
FILAMENT_PRICE_PER_KG=20.0
CURRENCY=£
# Average volumetric flow actually achieved. Calibrate from one real slice:
# if the slicer reports half our estimate, double this.
FLOW_RATE_MM3_S=8.0

# --- Providers ------------------------------------------------------------
# Which providers to use. The CSV provider needs no API key at all.
SET_PROVIDER=rebrickable_csv
MODEL_PROVIDER=ldraw
# Optional. Only needed for SET_PROVIDER=rebrickable_api (covers sets that
# are newer than your local dataset snapshot). Get one free at
# https://rebrickable.com/api/
REBRICKABLE_API_KEY=

# --- Startup --------------------------------------------------------------
# Download the catalogue and LDraw library automatically on first start if
# they are missing. This is what makes `docker compose up` a complete install.
AUTO_BOOTSTRAP=true

# --- Server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
