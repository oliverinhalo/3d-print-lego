# ---------------------------------------------------------------------------
# LEGO Set -> 3D Printable STL Generator : configuration
# Copy to .env and adjust. Every value below has a working default,
# so the application runs with an empty .env file.
# ---------------------------------------------------------------------------

# --- Storage --------------------------------------------------------------
# SQLite database holding the part index, job records and cache metadata.
DATABASE_URL=sqlite:///data/app.sqlite3
# Where downloaded source datasets (Rebrickable CSV + LDraw library) live.
SOURCE_DIRECTORY=data/sources
# Persistent STL geometry cache, shared by every job and every user.
CACHE_DIRECTORY=data/cache
# Per-job working directories and generated ZIP files.
OUTPUT_DIRECTORY=data/jobs

# --- Generation tuning ----------------------------------------------------
# Parallel geometry conversions. 5-10 is a sensible range.
MAX_CONCURRENT_DOWNLOADS=8
# Hard limit on a single generation job, in seconds.
JOB_TIMEOUT=1800
# Delete finished jobs (and their ZIPs) after this many seconds. Default 24h.
JOB_RETENTION=86400
# Discard cached geometry older than this many seconds. Default 30 days.
CACHE_RETENTION=2592000
# Retry attempts per part before it is reported as failed.
MAX_RETRIES=3
# Refuse to build sets larger than this many physical pieces (abuse guard).
MAX_PIECES_PER_JOB=6000
# Refuse to serve a ZIP larger than this many bytes (default 2 GiB).
MAX_ZIP_BYTES=2147483648

# --- Rate limiting --------------------------------------------------------
# Generation requests allowed per client IP per window.
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# --- STL / geometry -------------------------------------------------------
# LDraw unit -> millimetre scale. 1 LDU = 0.4 mm. Do not change unless you
# know exactly what you are doing.
LDU_MM=0.4
# Uniform scale applied to every exported part. LDraw geometry is *nominal*
# (a 2x4 brick is 32.00 mm) whereas real LEGO bricks are moulded slightly
# undersize (31.80 mm) to leave clutch tolerance. 1.0 keeps LDraw geometry
# untouched; 0.994 reproduces real-brick dimensions. See README.
PART_SCALE=1.0
# Write binary STL (much smaller). Set to false for ASCII STL.
STL_BINARY=true
# Place parts on the build plate before export (rests them on Z=0).
AUTO_ORIENT=true
# How to orient them. "native" keeps LDraw's orientation, which already has
# the flat underside down and the studs up — the right answer for almost
# every LEGO element. "flat" instead lays each part on its largest face.
ORIENT_STRATEGY=native

# --- Providers ------------------------------------------------------------
# Which providers to use. The CSV provider needs no API key at all.
SET_PROVIDER=rebrickable_csv
MODEL_PROVIDER=ldraw
# Optional. Only needed for SET_PROVIDER=rebrickable_api (covers sets that
# are newer than your local dataset snapshot). Get one free at
# https://rebrickable.com/api/
REBRICKABLE_API_KEY=

# --- Server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
