# Keep LF inside files that run in the Linux container, even when the
# repository is cloned on Windows with core.autocrlf=true. A CRLF shell
# script fails with "exec format error" inside the image.
* text=auto eol=lf
*.sh   text eol=lf
*.py   text eol=lf
Dockerfile text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Windows batch files MUST be CRLF. With LF endings cmd.exe mis-parses
# labels and goto targets, so the installer would fail in confusing ways.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets must never be line-ending converted.
*.png  binary
*.jpg  binary
*.stl  binary
*.zip  binary
*.dat  binary
